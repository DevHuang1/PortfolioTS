# Local loopback port exposed on the VPS (must match Nginx proxy_pass port)
# Change if 3010 is already used by another project on your z.com VPS.
HOST_PORT=3010

# Canonical public URL used for metadataBase, sitemap.xml, and robots.txt
# Examples: https://thutasitt.dev or https://portfolio.yourdomain.com
NEXT_PUBLIC_SITE_URL=https://thutasitt.dev
